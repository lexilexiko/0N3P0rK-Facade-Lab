{
  "name": "fasadlab",
  "version": "0.6.5",
  "private": true,
  "author": "ФасадЛаб",
  "description": "Генератор векторов мебельных фасадов",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ru.fasadlab.desktop",
    "productName": "ФасадЛаб",
    "files": [
      "main.js",
      "preload.js",
      "fasadlab_prototype.html",
      "node_modules/dxf-parser/dist/dxf-parser.js",
      "node_modules/dxf-parser/LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "dxf-parser": "^1.1.2"
  }
}
